"""
auto_referral_2captcha_termux.py
Termux/Mobile-friendly version with 2Captcha integration.
"""

import os
import csv
import time
import random
import string
import requests
from dotenv import load_dotenv
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.chrome.service import Service as ChromeService
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
from webdriver_manager.chrome import ChromeDriverManager

load_dotenv()

# === Settings ===
REFERRAL_URL = os.getenv("REFERRAL_URL", "https://sosovalue.com/join/H5I79Z8S")
CAPTCHA_API_KEY = os.getenv("CAPTCHA_API_KEY")
ACCOUNTS_CSV = os.getenv("ACCOUNTS_CSV", "accounts.csv")
LOOP_COUNT = int(os.getenv("LOOP_COUNT", "1"))
DELAY_BETWEEN = int(os.getenv("DELAY_BETWEEN", "10"))
DISPOSABLE_DOMAIN = os.getenv("DISPOSABLE_DOMAIN", "mailinator.com")
HEADLESS = os.getenv("BROWSER_HEADLESS", "false").lower() in ("1","true","yes")

# === Helpers ===
def random_string(n=10):
    return ''.join(random.choices(string.ascii_lowercase + string.digits, k=n))

def gen_email(domain=DISPOSABLE_DOMAIN):
    return f"{random_string(10)}@{domain}"

def gen_password(length=12):
    chars = string.ascii_letters + string.digits + "!@#$%^&*()-_"
    return ''.join(random.choices(chars, k=length))

def save_account(email, password, extra="", csvfile=ACCOUNTS_CSV):
    exists = os.path.isfile(csvfile)
    with open(csvfile, "a", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        if not exists:
            writer.writerow(["email","password","extra","timestamp"])
        writer.writerow([email,password,extra,time.strftime("%Y-%m-%d %H:%M:%S")])

# === Selenium Setup ===
def prepare_driver():
    options = webdriver.ChromeOptions()
    if HEADLESS:
        options.add_argument("--headless=new")
        options.add_argument("--window-size=1920,1080")
    options.add_argument("--disable-blink-features=AutomationControlled")
    service = ChromeService(ChromeDriverManager().install())
    driver = webdriver.Chrome(service=service, options=options)
    driver.maximize_window()
    return driver

# === 2Captcha Integration ===
def solve_recaptcha_v2(site_key, url):
    print("[+] Sending captcha to 2Captcha...")
    payload = {
        "key": CAPTCHA_API_KEY,
        "method": "userrecaptcha",
        "googlekey": site_key,
        "pageurl": url,
        "json": 1
    }
    r = requests.post("http://2captcha.com/in.php", data=payload)
    rid = r.json().get("request")
    print("[+] Waiting for captcha result...")
    for _ in range(20):
        time.sleep(5)
        res = requests.get(f"http://2captcha.com/res.php?key={CAPTCHA_API_KEY}&action=get&id={rid}&json=1").json()
        if res.get("status") == 1:
            print("[+] Captcha solved!")
            return res.get("request")
    print("[-] Captcha solving timed out.")
    return None

def inject_recaptcha_token(driver, token):
    driver.execute_script(
        "document.querySelector('textarea[name=\"g-recaptcha-response\"]').value = arguments[0];", token
    )

# === Form Filling ===
def fill_form(driver, email, password):
    wait = WebDriverWait(driver, 10)
    # Name
    try:
        el = wait.until(EC.presence_of_element_located((By.CSS_SELECTOR, "input[name*='name'], input[placeholder*='Name']")))
        el.clear()
        el.send_keys("Test User")
    except: pass
    # Email
    try:
        el = wait.until(EC.presence_of_element_located((By.CSS_SELECTOR, "input[type='email'], input[name='email']")))
        el.clear()
        el.send_keys(email)
    except: pass
    # Password
    try:
        el = wait.until(EC.presence_of_element_located((By.CSS_SELECTOR, "input[type='password'], input[name='password']")))
        el.clear()
        el.send_keys(password)
    except: pass

# === Main Loop ===
def main_loop():
    for i in range(LOOP_COUNT):
        driver = prepare_driver()
        try:
            driver.get(REFERRAL_URL)
            time.sleep(3)

            email = gen_email()
            password = gen_password()
            save_account(email, password, extra=f"ref={REFERRAL_URL}")

            fill_form(driver, email, password)
            print(f"[{i+1}] Form filled for {email}")

            # Detect reCAPTCHA
            frames = driver.find_elements(By.TAG_NAME, "iframe")
            site_key = None
            for f in frames:
                src = f.get_attribute("src") or ""
                if "google.com/recaptcha/api2/anchor" in src:
                    site_key = src.split("k=")[1].split("&")[0]
                    break

            if site_key and CAPTCHA_API_KEY:
                token = solve_recaptcha_v2(site_key, REFERRAL_URL)
                if token:
                    inject_recaptcha_token(driver, token)
                else:
                    print("[-] Could not auto-solve captcha.")
                    input("Solve manually and press ENTER to continue...")
            else:
                input("Press ENTER to submit form manually if needed...")

            # Submit
            try:
                btns = driver.find_elements(By.CSS_SELECTOR, "button, input[type='submit']")
                if btns:
                    btns[0].click()
                    print("Form submitted.")
            except: print("[-] Submit button not clicked.")

            time.sleep(3)

        except Exception as e:
            print("Error:", e)
        finally:
            driver.quit()
            if i < LOOP_COUNT-1:
                print(f"Sleeping {DELAY_BETWEEN}s before next account...")
                time.sleep(DELAY_BETWEEN)

if __name__ == "__main__":
    print("Starting Termux auto referral script with 2Captcha...")
    main_loop()
    print("Done.")
